COMPOSE_PROJECT_NAME=reconciliation-platform-dev
PUBLIC_WEB_PORT=4173
PUBLIC_WEB_HTTPS_PORT=4174
PORT=4000
LOG_LEVEL=info
MAX_UPLOAD_MB=10
RECON_PERSISTENCE_BACKEND=postgres
POSTGRES_DB=reconciliation_platform
POSTGRES_USER=recon_app
POSTGRES_PASSWORD=change-dev-password
POSTGRES_HOST_PORT=5432
ENABLE_PGAUDIT=true
NGINX_UI_HTTP_PORT=8082
NGINX_UI_HTTPS_PORT=8444
API_DATABASE_URL=postgresql://app_user:P%40ssw0rd@postgres:5432/reconciliation_platform
JWT_SECRET=change-dev-jwt-secret
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=60000
ENABLE_API_METRICS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_REDIS_URL=redis://redis:6379
RATE_LIMIT_REDIS_PREFIX=recon:rate-limit:
RECONCILIATION_RUN_STORE_PATH=/var/lib/reconciliation/latest-reconciliation-run.json
