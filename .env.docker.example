COMPOSE_PROJECT_NAME=reconciliation-platform
PUBLIC_WEB_PORT=4173
PORT=4000
LOG_LEVEL=info
MAX_UPLOAD_MB=10
RECON_PERSISTENCE_BACKEND=postgres
POSTGRES_DB=reconciliation_platform
POSTGRES_USER=recon_app
POSTGRES_PASSWORD=change-local-password
DATABASE_URL=postgresql://recon_app:change-local-password@postgres:5432/reconciliation_platform
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=60000
ENABLE_DEVELOPER_DIAGNOSTICS=false
RUN_DB_MIGRATIONS_ON_BOOT=false
RECONCILIATION_RUN_STORE_PATH=/var/lib/reconciliation/latest-reconciliation-run.json