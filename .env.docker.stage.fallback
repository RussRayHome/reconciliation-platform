COMPOSE_PROJECT_NAME=reconciliation-platform-stage
PUBLIC_WEB_PORT=4273
PORT=4000
LOG_LEVEL=info
MAX_UPLOAD_MB=10
RECON_PERSISTENCE_BACKEND=postgres
POSTGRES_DB=reconciliation_platform
POSTGRES_USER=recon_app
POSTGRES_PASSWORD=change-stage-password
POSTGRES_HOST_PORT=55432
ENABLE_PGAUDIT=true
NGINX_UI_HTTP_PORT=8182
NGINX_UI_HTTPS_PORT=8544
API_DATABASE_URL=postgresql://recon_app:change-stage-password@postgres:5432/reconciliation_platform
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=60000
ENABLE_DEVELOPER_DIAGNOSTICS=false
VITE_ENABLE_DEVELOPER_DASHBOARD=true
ENABLE_API_METRICS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_REDIS_URL=redis://redis:6379
RATE_LIMIT_REDIS_PREFIX=recon:rate-limit:
TOOLS_PORT=4002
RUN_DB_MIGRATIONS_ON_BOOT=false
RECONCILIATION_RUN_STORE_PATH=/var/lib/reconciliation/latest-reconciliation-run.json
