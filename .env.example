PORT=4000
VITE_API_BASE_URL=http://localhost:4000
LOG_LEVEL=info
DEBUG_RECONCILIATION=false
MAX_UPLOAD_MB=10
RECON_PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://recon:recon@localhost:5432/reconciliation_platform
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=60000
DEV_STATUS_CACHE_TTL_MS=300000
DEV_STATUS_HISTORY_LIMIT=10
ENABLE_DEVELOPER_DIAGNOSTICS=false
VITE_ENABLE_DEVELOPER_DASHBOARD=false
ENABLE_API_METRICS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_USE_REDIS=false
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_PREFIX=recon:rate-limit:

# Optional macOS/Homebrew Java configuration for Python- or JVM-backed tooling.
# Point JAVA_HOME at the JDK root, not the bin folder.
JAVA_HOME=/usr/local/Cellar/openjdk/25.0.2/libexec/openjdk.jdk/Contents/Home
JAVA_BIN=/usr/local/Cellar/openjdk/25.0.2/libexec/openjdk.jdk/Contents/Home/bin/java
