PORT=4000
VITE_API_BASE_URL=http://localhost:4000
LOG_LEVEL=info
DEBUG_RECONCILIATION=false
MAX_UPLOAD_MB=10

# Optional macOS/Homebrew Java configuration for Python- or JVM-backed tooling.
# Point JAVA_HOME at the JDK root, not the bin folder.
JAVA_HOME=/usr/local/Cellar/openjdk/25.0.2/libexec/openjdk.jdk/Contents/Home
JAVA_BIN=/usr/local/Cellar/openjdk/25.0.2/libexec/openjdk.jdk/Contents/Home/bin/java
