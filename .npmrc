# Drift review finding #09: .nvmrc, every Dockerfile, and all 5 CI workflows already pin/resolve
# Node 26.5.1 consistently -- package.json's own engines.node was the one place that wasn't
# actually enforced (a loose ">=20.0.0" range npm never checks by default). engine-strict turns
# engines.node from an informational field into an install-time error the moment a different
# Node resolves here.
engine-strict=true
