ARG POSTGRES_BASE_IMAGE=postgres:16.13
FROM ${POSTGRES_BASE_IMAGE}

ARG ENABLE_PGAUDIT=false

RUN set -eux; \
        if command -v apk >/dev/null 2>&1; then \
            apk add --no-cache \
                musl-locales \
                musl-locales-lang; \
            if [ "${ENABLE_PGAUDIT}" = "true" ]; then \
                echo "pgAudit installation is not supported on the Alpine Postgres base image." >&2; \
                echo "Use a Debian Postgres base image when ENABLE_PGAUDIT=true." >&2; \
                exit 1; \
            fi; \
        else \
            apt-get update; \
            apt-get install -y --no-install-recommends locales; \
            if [ "${ENABLE_PGAUDIT}" = "true" ]; then \
                apt-get install -y --no-install-recommends postgresql-16-pgaudit; \
            fi; \
            rm -rf /var/lib/apt/lists/*; \
        fi

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

CMD ["postgres"]