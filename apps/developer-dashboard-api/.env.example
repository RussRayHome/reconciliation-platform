# Which published status this deployment serves -- "dev" or "stage". Each environment runs its
# own instance of this app (mirrors the product's own compose.dev.yaml / compose.stage.yaml split).
DASHBOARD_ENV=dev

# owner/repo of the reconciliation-platform repo -- where status-data lives.
DASHBOARD_STATUS_REPO=RussRayHome/reconciliation-platform

# Fine-grained PAT scoped to contents:read only on that repo. This app never writes to git.
DASHBOARD_STATUS_READ_TOKEN=

# GitHub OAuth App credentials -- github.com/settings/developers -> OAuth Apps -> New OAuth App.
DASHBOARD_GITHUB_CLIENT_ID=
DASHBOARD_GITHUB_CLIENT_SECRET=
# Must exactly match one of the callback URLs registered on the OAuth App.
DASHBOARD_GITHUB_CALLBACK_URL=http://127.0.0.1:4500/api/auth/github/callback

# Comma-separated GitHub logins allowed to sign in. Empty = nobody can sign in.
DASHBOARD_ALLOWED_GITHUB_LOGINS=russray2008

# The web app's own origin -- used for CORS and the post-login redirect.
DASHBOARD_WEB_ORIGIN=http://127.0.0.1:5500

# Session JWT signing secret. Required in production; auto-generated (and unstable across
# restarts) in local dev if left unset.
DASHBOARD_JWT_SECRET=

PORT=4500
LOG_LEVEL=info
