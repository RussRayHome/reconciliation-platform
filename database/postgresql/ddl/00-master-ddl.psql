-- Master DDL runner for the reconciliation platform PostgreSQL schema.
-- Sequence:
--   1) Create database
--   2) Create users (existing repository script)
--   3) Create tables and related schema objects
\set ON_ERROR_STOP on

\echo 'Step 1/3: Ensuring database reconciliation_platform exists'
\ir 01-create-database.psql

\echo 'Step 2/3: Creating or updating users from scripts/db/dev-stage/create-users.psql'
\connect reconciliation_platform
\ir 02-create-users.psql

\echo 'Step 3/3: Creating tables and schema objects in reconciliation_platform'
\ir 03-create-tables.psql

\echo 'Master DDL completed successfully.'
