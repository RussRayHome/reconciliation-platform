{
  "openapi": "3.0.3",
  "info": {
    "title": "Reconciliation Platform API",
    "version": "0.1.0",
    "description": "Operational API for authentication, reconciliation execution, run reports, and exports."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current origin"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "summary": "Readiness check (error-handling-build-plan.md EH8)",
        "description": "Reports whether required dependencies (currently: the database, when configured) are reachable. Point orchestrator/ALB readiness checks here instead of /api/health, which never touches the database.",
        "responses": {
          "200": {
            "description": "Ready -- either the database is reachable, or none is configured"
          },
          "503": {
            "description": "Not ready -- a configured database is unreachable"
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Prometheus API metrics",
        "responses": {
          "200": {
            "description": "Prometheus metrics payload"
          },
          "404": {
            "description": "Metrics endpoint disabled"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bearer token and authenticated user profile"
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Revoke the current bearer token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Token revoked (or already expired/absent)"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get the authenticated principal for the current bearer token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current username, role, and organization"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/reconciliation/run": {
      "post": {
        "summary": "Run reconciliation synchronously or enqueue a queued run",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "bankFile",
                  "glFile"
                ],
                "properties": {
                  "bankFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "glFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "accountIdentifier": {
                    "type": "string"
                  },
                  "periodLabel": {
                    "type": "string"
                  },
                  "reconciliationFrequency": {
                    "type": "string",
                    "enum": [
                      "Monthly",
                      "Annual"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Synchronous reconciliation result"
          },
          "202": {
            "description": "Queued reconciliation accepted"
          },
          "400": {
            "description": "Invalid upload payload"
          }
        }
      }
    },
    "/api/reconciliation/jobs/{jobId}": {
      "get": {
        "summary": "Get queued reconciliation job status",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Queued job status payload"
          },
          "404": {
            "description": "Queued job not found"
          }
        }
      }
    },
    "/api/saved-views": {
      "get": {
        "summary": "List the saved views this user may see (Issue #458)",
        "description": "The caller's own views at any visibility, plus every view shared with the finance team. Retired views are excluded unless asked for.",
        "parameters": [
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "type": "string",
              "enum": [
                "exceptions",
                "open_items"
              ]
            }
          },
          {
            "in": "query",
            "name": "includeRetired",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved views, most recently updated first"
          },
          "400": {
            "description": "Unrecognised scope or includeRetired value"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "post": {
        "summary": "Save a new view (Issue #458)",
        "description": "The author becomes the first owner. Visibility defaults to private -- sharing is an explicit act.",
        "responses": {
          "201": {
            "description": "Saved view created"
          },
          "400": {
            "description": "Invalid body (missing scope, empty or over-long name)"
          },
          "401": {
            "description": "Not authenticated"
          },
          "409": {
            "description": "This owner already has an active view of that name"
          }
        }
      }
    },
    "/api/saved-views/{savedViewId}": {
      "patch": {
        "summary": "Update a saved view, including retiring it (Issue #458)",
        "description": "Owner-only. `scope` cannot be changed -- it is what the saved filters mean. There is no DELETE: a view is retired by patching status to RETIRED, which frees its name for reuse without losing the row.",
        "parameters": [
          {
            "in": "path",
            "name": "savedViewId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated saved view"
          },
          "400": {
            "description": "Malformed id or invalid body"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Readable by this user, but owned by someone else"
          },
          "404": {
            "description": "No such view in this organization"
          },
          "409": {
            "description": "The target name is already in use by an active view"
          }
        }
      }
    },
    "/api/reconciliation/latest": {
      "get": {
        "summary": "Fetch the latest completed reconciliation run",
        "responses": {
          "200": {
            "description": "Latest run report"
          },
          "404": {
            "description": "No completed run available"
          }
        }
      }
    },
    "/api/reconciliation/{id}": {
      "get": {
        "summary": "Fetch a reconciliation run report by run ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run report"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/reconciliation/{id}/summary": {
      "get": {
        "summary": "Fetch run summary by run ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run summary"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/reconciliation/{id}/exceptions": {
      "get": {
        "summary": "Fetch run exceptions (optionally paginated)",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exceptions list or page object"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/reconciliation/{id}/export/workbook": {
      "get": {
        "summary": "Download output workbook for a reconciliation run",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workbook download"
          },
          "404": {
            "description": "Workbook not available for run"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
