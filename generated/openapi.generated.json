{
  "openapi": "3.0.3",
  "info": {
    "title": "Reconciliation Platform API",
    "version": "0.1.0",
    "description": "Operational API for authentication, reconciliation execution, run reports, and exports."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current origin"
    }
  ],
  "paths": {
    "/api/accounts": {
      "get": {
        "summary": "List reconciliation accounts",
        "responses": {
          "200": {
            "description": "The organization’s accounts"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        }
      },
      "post": {
        "summary": "Register a reconciliation account",
        "responses": {
          "201": {
            "description": "Account created"
          },
          "400": {
            "description": "Request failed validation"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "403": {
            "description": "The signed-in role may not perform this action"
          }
        }
      }
    },
    "/api/accounts/suggest": {
      "get": {
        "summary": "Suggest an account for an uploaded statement",
        "description": "Matches a bank file name against registered accounts. Advisory only — the operator confirms the assignment, and a disagreement is reported rather than auto-resolved.",
        "responses": {
          "200": {
            "description": "Ranked suggestions"
          },
          "401": {
            "description": "Missing or invalid credentials"
          }
        }
      }
    },
    "/api/accounts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "summary": "Amend a reconciliation account",
        "responses": {
          "200": {
            "description": "Updated account"
          },
          "400": {
            "description": "Request failed validation"
          },
          "403": {
            "description": "The signed-in role may not perform this action"
          },
          "404": {
            "description": "Not found, or not visible to this organization"
          }
