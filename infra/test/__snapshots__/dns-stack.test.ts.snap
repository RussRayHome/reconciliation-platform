exports[`DnsStack > matches the synthesized CloudFormation template snapshot 1`] = `
{
  "Outputs": {
    "NameServers": {
      "Description": "Delegate rb-kinneysoft.com to these name servers at the domain registrar.",
      "Value": {
        "Fn::Join": [
          ", ",
          {
            "Fn::GetAtt": [
              "ZoneA5DE4B68",
              "NameServers",
            ],
          },
        ],
      },
    },
  },
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ZoneA5DE4B68": {
      "Properties": {
        "Name": "rb-kinneysoft.com.",
