        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code) (rate(recon_api_http_requests_total{compose_project=\"$environment\"}[5m]))",
          "legendFormat": "{{status_code}}"
        }
