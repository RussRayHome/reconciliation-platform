    {
      "id": 601,
      "type": "timeseries",
      "title": "Web gateway request rate by status",
      "description": "apps/web/nginx.conf's json_access log format, purpose-built for Loki ingestion. |= \"remote_addr\" scopes to real access-log lines only, excluding nginx's own plain-text worker-process notices sharing this container's log stream.",
