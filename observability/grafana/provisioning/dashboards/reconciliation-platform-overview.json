    {
      "id": 13,
      "type": "timeseries",
      "title": "Reconciliation runs (received vs completed)",
      "description": "A gap between 'received' and 'completed' over time is the proxy for in-flight/failed runs -- there is no distinct reconciliation.run.failed log action today. 'received' only ever fires from the legacy standalone /api/reconciliation/run route (runReconciliationWorkflow, app.ts) -- the modern Import Files flow (triggerMatchingForImportRun) logs 'completed' only, so 'received' will read zero for that path even though it's working correctly.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
