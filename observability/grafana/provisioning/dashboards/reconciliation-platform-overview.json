    {
      "id": 503,
      "type": "timeseries",
      "title": "Host CPU utilization (Docker Desktop VM)",
      "description": "On Docker Desktop for macOS, 'host' means Docker Desktop's own Linux VM, not literally the Mac's hardware -- that VM is what every container in every stack actually competes for CPU inside, which is exactly the right scope for a shared-laptop-contention question. Single node-exporter instance, so this is not scoped by $environment -- it reflects total VM-wide utilization regardless of which stack is selected above.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 79
      },
