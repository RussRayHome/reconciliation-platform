{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "id": 100, "type": "row", "title": "API Metrics (Prometheus)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by status code",
      "description": "sum(rate(recon_api_http_requests_total[5m])) by (status_code)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status_code) (rate(recon_api_http_requests_total{compose_project=\"$environment\"}[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx/s)",
      "description": "sum(rate(recon_api_http_request_errors_total[5m])) by (route)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 }, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(recon_api_http_request_errors_total{compose_project=\"$environment\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "description": "histogram_quantile over recon_api_http_request_duration_seconds_bucket",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(recon_api_http_request_duration_seconds_bucket{compose_project=\"$environment\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(recon_api_http_request_duration_seconds_bucket{compose_project=\"$environment\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(recon_api_http_request_duration_seconds_bucket{compose_project=\"$environment\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Top routes by request volume (5m rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, sum by (route) (rate(recon_api_http_requests_total{compose_project=\"$environment\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API process memory (RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "recon_api_process_resident_memory_bytes{compose_project=\"$environment\"}",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Event loop lag (p99)",
      "description": "Node.js event loop lag -- sustained high values mean the API process is CPU-blocked and can't service new requests promptly.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "recon_api_nodejs_eventloop_lag_p99_seconds{compose_project=\"$environment\"}",
          "legendFormat": "p99 lag"
        }
      ]
    },

    { "id": 200, "type": "row", "title": "Service Activity (Logs)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }, "collapsed": false, "panels": [] },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Log volume by container",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (compose_service) (count_over_time({compose_project=\"$environment\"}[$__interval]))",
          "legendFormat": "{{compose_service}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Error-level log rate by container",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 }, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (compose_service) (count_over_time({compose_project=\"$environment\", level=\"error\"}[$__interval]))",
          "legendFormat": "{{compose_service}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Auth activity (success vs failure)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (action) (count_over_time({compose_project=\"$environment\", compose_service=\"api\"} | json | action=~\"auth\\\\.login_(success|failure)\" [$__interval]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Reconciliation runs (received vs completed)",
      "description": "A gap between 'received' and 'completed' over time is the proxy for in-flight/failed runs -- there is no distinct reconciliation.run.failed log action today.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (action) (count_over_time({compose_project=\"$environment\", compose_service=\"api\"} | json | action=~\"reconciliation\\\\.run\\\\.(received|completed)\" [$__interval]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Import validation runs (passed vs failed)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (action) (count_over_time({compose_project=\"$environment\", compose_service=~\"api|worker\"} | json | action=~\"import-validation\\\\.run\\\\.(matched|failed)\" [$__interval]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Queue events (producer/consumer, by action)",
      "description": "Issue #134: reconciliation/import-validation queue lifecycle events across both the api (producer) and worker (consumer) containers.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (action) (count_over_time({compose_project=\"$environment\", compose_service=~\"api|worker\"} | json | action=~\"reconciliation\\\\.queue\\\\..+|import-validation\\\\.queue\\\\..+\" [$__interval]))",
          "legendFormat": "{{action}}"
        }
      ]
    },

    { "id": 300, "type": "row", "title": "Recent Errors", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 }, "collapsed": false, "panels": [] },
    {
      "id": 20,
      "type": "logs",
      "title": "Recent error-level log lines, all containers",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 51 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{compose_project=\"$environment\", level=\"error\"} | json",
          "queryType": "range",
          "maxLines": 1000
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["reconciliation-platform", "overview"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "label": "Compose project",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "query": "label_values(compose_project)", "refId": "environment" },
        "refresh": 2,
        "sort": 1,
        "current": { "text": "reconciliation-platform-dev", "value": "reconciliation-platform-dev" },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
