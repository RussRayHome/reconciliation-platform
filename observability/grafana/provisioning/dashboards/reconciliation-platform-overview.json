            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total[1m]))",
          "legendFormat": "requests/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(k6_http_req_failed_rate)",
          "legendFormat": "failure rate"
        }
      ]
    }
