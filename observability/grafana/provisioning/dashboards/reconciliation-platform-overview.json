    {
      "id": 402,
      "type": "timeseries",
      "title": "k6 HTTP request rate & failure rate",
      "description": "Per-request numbers underlying the golden-path flow (login/create/submit/poll/approve combined). Failure rate should read 0 -- any nonzero value means the golden path itself broke, not just got slower.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 62
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failure rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
