{
  "name": "reconciliation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @recon/api",
    "dev:web": "npm run dev --workspace @recon/web",
    "dev:api:test": "npm run dev:test --workspace @recon/api",
    "dev:web:test": "npm run dev:test --workspace @recon/web",
    "harness:start": "tsx scripts/runtime-harness.ts start",
    "harness:restart": "tsx scripts/runtime-harness.ts restart",
    "harness:stop": "tsx scripts/runtime-harness.ts stop",
    "harness:status": "tsx scripts/runtime-harness.ts status",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit-core --project unit-web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "coverage": "vitest run --coverage --project unit-core --project unit-web --project integration",
    "security:scan": "npm audit --audit-level=high",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "analyze:reconciliation": "tsx scripts/analyze-reconciliation.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.3"
  }
}
