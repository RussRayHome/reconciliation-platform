{
  "name": "reconciliation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "uuid": "11.1.1",
    "brace-expansion": "5.0.9",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "@types/pg": "8.20.3"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "concurrently -k -n API,WEB \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @recon/api",
    "dev:web": "npm run dev --workspace @recon/web",
    "dev:api:test": "npm run dev:test --workspace @recon/api",
    "dev:web:test": "npm run dev:test --workspace @recon/web",
    "dev:dashboard": "concurrently -k -n DASH-API,DASH-WEB \"npm run dev:dashboard-api\" \"npm run dev:dashboard-web\"",
    "dev:dashboard-api": "npm run dev --workspace @recon/developer-dashboard-api",
    "dev:dashboard-web": "npm run dev --workspace @recon/developer-dashboard-web",
    "ops:web:start": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts web start",
    "ops:web:stop": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts web stop",
    "ops:db:start": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts db start",
    "ops:db:stop": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts db stop",
    "ops:docker:stop": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts docker stop",
    "ops:docker:restart": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts docker restart",
    "ops:startup": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts stack start",
    "ops:shutdown": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-ops.ts stack stop",
    "harness:start": "NODE_OPTIONS=--no-deprecation tsx scripts/runtime-harness.ts start",
    "harness:restart": "NODE_OPTIONS=--no-deprecation tsx scripts/runtime-harness.ts restart",
    "harness:stop": "NODE_OPTIONS=--no-deprecation tsx scripts/runtime-harness.ts stop",
    "harness:status": "NODE_OPTIONS=--no-deprecation tsx scripts/runtime-harness.ts status",
    "runtime:status": "NODE_OPTIONS=--no-deprecation tsx scripts/runtime-status.ts",
    "docker:validate-env": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/validate-env.sh",
    "docker:preflight": "npm run docker:preflight:dev",
    "docker:preflight:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/preflight-build-checks.sh",
    "docker:preflight:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/preflight-build-checks.sh",
    "docker:build": "sh -c 'env_file=.env.docker.dev; [ -f \"$env_file\" ] || env_file=.env.docker.dev.fallback; docker compose -f compose.yaml -f compose.dev.yaml --env-file \"$env_file\" build'",
    "docker:cert:dev": "bash scripts/pre-flight/generate-tls-cert.sh dev",
    "docker:cert:stage": "bash scripts/pre-flight/generate-tls-cert.sh stage",
    "docker:predeploy": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/predeploy-stack-checks.sh",
    "docker:db:preflight": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/db-preflight-checks.sh",
    "docker:db:preflight:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/db-preflight-checks.sh",
    "docker:db:preflight:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/db-preflight-checks.sh",
    "docker:gate": "npm run docker:preflight && npm run docker:predeploy",
    "docker:migrate": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/run-migrations.sh",
    "docker:health": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/health-check.sh",
    "docker:health:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/health-check.sh",
    "docker:health:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/health-check.sh",
    "docker:url-check:inflight": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/in-flight/in-flight-url-check.sh",
    "docker:url-check:inflight:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/in-flight/in-flight-url-check.sh",
    "docker:url-check:inflight:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/in-flight/in-flight-url-check.sh",
    "docker:user-check:inflight": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/in-flight/in-flight-db-user-check.sh",
    "docker:user-check:inflight:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/in-flight/in-flight-db-user-check.sh",
    "docker:user-check:inflight:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/in-flight/in-flight-db-user-check.sh",
    "docker:deploy": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/deploy.sh",
    "docker:deploy:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/deploy.sh",
    "docker:deploy:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/deploy.sh",
    "docker:redeploy": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/redeploy.sh",
    "docker:redeploy:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/redeploy.sh",
    "docker:redeploy:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/redeploy.sh",
    "docker:smoke": "NODE_OPTIONS=--no-deprecation tsx scripts/docker-smoke-test.ts",
    "docker:up": "sh -c 'env_file=.env.docker.dev; [ -f \"$env_file\" ] || env_file=.env.docker.dev.fallback; docker compose -f compose.yaml -f compose.dev.yaml --env-file \"$env_file\" up --build'",
    "docker:cleanup": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/cleanup.sh",
    "docker:cleanup:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/cleanup.sh",
    "docker:cleanup:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/cleanup.sh",
    "docker:down": "sh -c 'env_file=.env.docker.dev; [ -f \"$env_file\" ] || env_file=.env.docker.dev.fallback; docker compose -f compose.yaml -f compose.dev.yaml --env-file \"$env_file\" down --remove-orphans'",
    "docker:logs": "sh -c 'env_file=.env.docker.dev; [ -f \"$env_file\" ] || env_file=.env.docker.dev.fallback; docker compose -f compose.yaml -f compose.dev.yaml --env-file \"$env_file\" logs -f'",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit-core --project unit-web",
    "test:integration": "LOG_LEVEL=silent vitest run --project integration --reporter=dot",
    "test:integration:dashboard": "LOG_LEVEL=silent vitest run --project integration --reporter=dot --exclude apps/api/tests/deploy-cleanup.test.ts --exclude apps/api/tests/nginx-config.test.ts",
    "test:postgres": "RUN_POSTGRES_TESTS=true vitest run --config vitest.postgres.config.ts",
    "test:postgres:update-baseline": "UPDATE_SCHEMA_BASELINE=true vitest run --config vitest.postgres.config.ts packages/persistence/tests/schemaBaseline.test.ts",
    "test:postgres:dashboard": "DB_PREFLIGHT_FAIL_ON_CRITICAL=false npm run docker:db:preflight:dev",
    "test:e2e": "NODE_OPTIONS=--no-deprecation playwright test",
    "test:e2e:functional": "NODE_OPTIONS=--no-deprecation playwright test --project=functional",
    "test:e2e:visual": "NODE_OPTIONS=--no-deprecation playwright test --project=visual",
    "test:e2e:visual:update-snapshots": "NODE_OPTIONS=--no-deprecation playwright test --project=visual --update-snapshots",
    "test:e2e:visual:container": "docker compose -f compose.e2e.yaml --profile e2e-visual run --rm visual-e2e",
    "test:e2e:visual:container:update-snapshots": "docker compose -f compose.e2e.yaml --profile e2e-visual run --rm visual-e2e npm run test:e2e:visual:update-snapshots",
    "lint": "eslint .",
    "analyze:static": "npm run lint && npm run analyze:test-quality && npm run analyze:deps && npm run analyze:unused-exports && npm run analyze:complexity",
    "analyze:deps": "depcruise --config .dependency-cruiser.cjs --output-type err-long apps packages scripts",
    "analyze:test-quality": "NODE_OPTIONS=--no-deprecation tsx scripts/check-test-assertions.ts",
    "analyze:unused-exports": "NODE_OPTIONS=--no-deprecation tsx scripts/triage-unused-exports.ts",
    "analyze:unused-exports:raw": "ts-prune -p tsconfig.typecheck.json -s \"(\\.test\\.|\\.spec\\.|/tests/|/coverage/|/docs/)\"",
    "analyze:unused-exports:baseline:update": "NODE_OPTIONS=--no-deprecation tsx scripts/triage-unused-exports.ts --update",
    "analyze:complexity": "NODE_OPTIONS=--no-deprecation tsx scripts/escomplex-analysis.ts",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "coverage": "vitest run --coverage --no-file-parallelism --project unit-core --project unit-web --project unit-data --project integration --exclude apps/api/tests/deploy-cleanup.test.ts",
    "coverage:docker-fallback": "vitest run --coverage --no-file-parallelism --project unit-core --project unit-web --project integration --exclude apps/api/tests/deploy-cleanup.test.ts",
    "security:scan": "npm audit --audit-level=high",
    "security:scan:component:api": "node scripts/security-scan-api.mjs",
    "security:scan:component:database": "node scripts/security-scan-database.mjs",
    "security:scan:component:container": "node scripts/security-scan-container-component.mjs",
    "security:scan:component:web-server": "node scripts/security-scan-web-server.mjs",
    "security:scan:components": "node scripts/security-component-scan.mjs",
    "security:scan:secrets": "node scripts/security-scan-secrets.mjs",
    "security:scan:zap:web:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/zap-web-scan.sh",
    "security:scan:zap:api:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/zap-api-scan.sh",
    "security:scan:zap:web:stage:strict": "ZAP_FAIL_ON_WARN=true npm run security:scan:zap:web:stage",
    "security:scan:zap:api:stage:strict": "ZAP_FAIL_ON_WARN=true npm run security:scan:zap:api:stage",
    "security:scan:zap:stage": "npm run security:scan:zap:web:stage && npm run security:scan:zap:api:stage",
    "security:scan:zap:stage:strict": "npm run security:scan:zap:web:stage:strict && npm run security:scan:zap:api:stage:strict",
    "aws:ecr:push": "bash scripts/pre-flight/ecr-push.sh",
    "aws:prod:up": "cd infra && npm run infra:up",
    "aws:prod:down": "cd infra && npm run infra:down",
    "aws:prod:push": "cd infra && npm run infra:push",
    "aws:prod:diff": "cd infra && npm run infra:diff",
    "aws:prod:install": "cd infra && npm install",
    "db:users:dev": "bash scripts/pre-flight/run-users.sh dev",
    "db:users:stage": "bash scripts/pre-flight/run-users.sh stage",
    "db:users:prod-rray": "bash scripts/pre-flight/run-prod-users.sh prod-rray",
    "db:users:prod-rray-admin": "bash scripts/pre-flight/run-prod-users.sh prod-rray-admin",
    "db:backup": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/backup.sh dev",
    "db:backup:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/backup.sh dev",
    "db:backup:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/backup.sh stage",
    "db:restore:dev": "DOCKER_ENV_FILE=.env.docker.dev DOCKER_ENV_FALLBACK_FILE=.env.docker.dev.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.dev.yaml bash scripts/pre-flight/restore.sh dev",
    "db:restore:stage": "DOCKER_ENV_FILE=.env.docker.stage DOCKER_ENV_FALLBACK_FILE=.env.docker.stage.fallback DOCKER_COMPOSE_EXTRA_FILE=compose.stage.yaml bash scripts/pre-flight/restore.sh stage",
    "db:seed:dev": "bash scripts/pre-flight/run-seed.sh dev",
    "db:seed:stage": "bash scripts/pre-flight/run-seed.sh stage",
    "github:protect-main": "NODE_OPTIONS=--no-deprecation tsx scripts/github-branch-protection.ts --branch main",
    "fixtures:generate": "NODE_OPTIONS=--no-deprecation tsx scripts/generate-fixtures.ts",
    "analyze:reconciliation": "NODE_OPTIONS=--no-deprecation tsx scripts/analyze-reconciliation.ts",
    "compare:workbooks": "python3 scripts/workbook-compare.py",
    "changelog:promote": "NODE_OPTIONS=--no-deprecation tsx scripts/changelog-promote.ts",
    "docs:api:generate": "NODE_OPTIONS=--no-deprecation tsx scripts/generate-api-docs.ts",
    "docs:api:check": "NODE_OPTIONS=--no-deprecation tsx scripts/generate-api-docs.ts --check",
    "docs:openapi:generate": "NODE_OPTIONS=--no-deprecation tsx scripts/generate-openapi-docs.ts",
    "docs:openapi:check": "NODE_OPTIONS=--no-deprecation tsx scripts/generate-openapi-docs.ts --check",
    "licenses:generate": "NODE_OPTIONS=--no-deprecation node scripts/check-licenses.mjs",
    "licenses:check": "NODE_OPTIONS=--no-deprecation node scripts/check-licenses.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^18.0.0",
    "escomplex": "^2.0.0-alpha",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.1.0",
    "esprima": "^4.0.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.0",
    "supertest": "^7.1.0",
    "testcontainers": "^12.0.3",
    "ts-prune": "^0.10.3",
    "tsup": "^8.4.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@sentry/node": "^10.62.0",
    "@sentry/react": "^10.62.0",
    "@tanstack/query-sync-storage-persister": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "@tanstack/react-virtual": "^3.14.4",
    "bullmq": "^5.79.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.0.1"
  }
}
