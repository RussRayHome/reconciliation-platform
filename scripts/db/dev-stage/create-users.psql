-- =============================================================================
-- DEV AND STAGE ENVIRONMENTS ONLY
-- DO NOT RUN IN PRODUCTION.
--
-- Creates the 'rray' database user with superuser and database-admin privileges,
-- and seeds the application-level login accounts in reconciliation_user (the
-- table the app's /api/auth/login endpoint actually queries — separate from the
-- Postgres roles below). Without this, a fresh deployment has a working database
-- but no way to log into the application, since there is no self-service
-- registration endpoint.
-- Idempotent: safe to run multiple times.
--
-- How to run (dev):
--   bash scripts/pre-flight/run-users.sh dev
--
-- How to run (stage):
--   bash scripts/pre-flight/run-users.sh stage
--
-- Or manually via psql:
--   psql -h <host> -p <port> -U <admin-user> -d reconciliation_platform \
--       -f scripts/db/dev-stage/create-users.psql
-- =============================================================================

\echo 'Creating dev/stage user: rray'

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'recon_app') THEN
    CREATE ROLE recon_app
      LOGIN
      NOSUPERUSER
      NOCREATEDB
      NOCREATEROLE
      NOREPLICATION
      PASSWORD 'change-local-password';
    RAISE NOTICE 'Role recon_app created for default privilege grants.';
  END IF;
END;
$$;

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'rray') THEN
    CREATE ROLE rray
      LOGIN
      SUPERUSER
      CREATEDB
      CREATEROLE
      PASSWORD 'P@ssw0rd';
    RAISE NOTICE 'Role rray created.';
  ELSE
    ALTER ROLE rray
      LOGIN
      SUPERUSER
      CREATEDB
      CREATEROLE
      PASSWORD 'P@ssw0rd';
    RAISE NOTICE 'Role rray already exists — attributes updated.';
  END IF;
END;
$$;

-- Full database access
GRANT ALL PRIVILEGES ON DATABASE reconciliation_platform TO rray;

-- Full access to all current objects in the public schema
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO rray;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO rray;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA public TO rray;
GRANT ALL PRIVILEGES ON ALL PROCEDURES IN SCHEMA public TO rray;
GRANT ALL PRIVILEGES ON SCHEMA public TO rray;

-- Full access to objects created in future by the application role
ALTER DEFAULT PRIVILEGES FOR ROLE recon_app IN SCHEMA public
  GRANT ALL PRIVILEGES ON TABLES TO rray;

ALTER DEFAULT PRIVILEGES FOR ROLE recon_app IN SCHEMA public
  GRANT ALL PRIVILEGES ON SEQUENCES TO rray;

ALTER DEFAULT PRIVILEGES FOR ROLE recon_app IN SCHEMA public
  GRANT ALL PRIVILEGES ON FUNCTIONS TO rray;

\echo 'Done. User rray is configured for dev/stage.'

-- -----------------------------------------------------------------------------
-- Application login accounts (reconciliation_user table)
-- -----------------------------------------------------------------------------
-- This script runs before migrations on first deploy, so reconciliation_user
-- won't exist yet on a brand-new database — skip quietly in that case. deploy.sh
-- also re-runs this script after migrations complete, at which point the table
-- exists and this block seeds/updates the accounts.
-- Changeset 0026 replaced the plaintext `password` column with `password_hash` (bcrypt, via the
-- pgcrypto extension that same changeset installs) and added NOT NULL `role` and
-- `organization_id` columns. This block hashes with pgcrypto's crypt()/gen_salt('bf') -- the
-- same bcrypt algorithm apps/api/src/services/authService.ts verifies with bcryptjs -- and
-- resolves organization_id by name against 'Default Organization', which changeset 0026 itself
-- seeds. Roles mirror apps/api/src/app.ts's localLoginUsers fallback table, so DB-backed and
-- local-fallback login behave the same for these four accounts.
--
-- Changeset 0034 added identity/entity verification gates (POST /api/mapping/profiles requires
-- both 'verified'). These three accounts are pre-provisioned, not signed up through the real
-- flow, so they're seeded already-verified -- otherwise every fresh dev/stage deploy would need a
-- manual identity-code confirm and entity-verification retry just to unblock mapping creation for
-- its own seeded users.
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name = 'reconciliation_user') THEN
    INSERT INTO reconciliation_user
      (user_name, first_name, last_name, password_hash, role, organization_id, identity_verification_status)
    SELECT
      v.user_name, v.first_name, v.last_name, crypt(v.plain_password, gen_salt('bf')), v.role, org.id, 'verified'
    FROM (VALUES
      ('rray', 'R', 'Ray', 'P@ssw0rd', 'superuser'),
      ('rray3', 'R', 'Ray3', 'P@ssw0rd', 'admin'),
      ('bray', 'B', 'Ray', 'bray123', 'financial-analyst'),
      -- senior-analyst (File Imports & Validation): the only role besides admin/superuser that
      -- can submit an import run (canSubmitImportRuns, packages/domain/src/enums.ts) -- bray
      -- (financial-analyst) can't, so E2E specs exercising the upload/submit flow need this
      -- account rather than reusing bray's.
      ('bray2', 'B', 'Ray2', 'P@ssw0rd', 'senior-analyst')
    ) AS v(user_name, first_name, last_name, plain_password, role)
    CROSS JOIN (SELECT id FROM reconciliation_organization WHERE name = 'Default Organization') AS org
    ON CONFLICT (user_name) DO UPDATE
      SET first_name = EXCLUDED.first_name,
          last_name = EXCLUDED.last_name,
          password_hash = EXCLUDED.password_hash,
          role = EXCLUDED.role,
          organization_id = EXCLUDED.organization_id,
          identity_verification_status = 'verified';

    DELETE FROM reconciliation_user WHERE user_name = 'rray2';

    UPDATE reconciliation_organization
    SET entity_verification_status = 'verified'
    WHERE name = 'Default Organization';

    RAISE NOTICE 'Application login accounts (rray, rray3, bray, bray2) seeded in reconciliation_user.';
  ELSE
    RAISE NOTICE 'reconciliation_user does not exist yet — skipping application login seed (re-run after migrations).';
  END IF;
END;
$$;
