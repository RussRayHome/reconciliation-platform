ssue", "value": 600}, {"label": "Deposit Grouping Issue", "value": 6400}, {"label": "Duplicate in Bank", "value": 210}, {"label": "Intercompany / Entity Mismatch", "value": 1000}, {"label": "Fee Netting Match", "value": 203.6}, {"label": "Partial Payment Match", "value": 603}, {"label": "ACH Return / NSF", "value": 600}, {"label": "Bank Service Charge (Amortized)", "value": 242}, {"label": "Chargeback / Returned Item", "value": 750}, {"label": "Payroll Batch Match", "value": 10002}, {"label": "NSF / Returned Deposit", "value": 317.89}, {"label": "Loan Payment Split", "value": 2500}, {"label": "Voided Check Cleared", "value": 657.33}, {"label": "Missing from Bank", "value": 3735}, {"label": "Duplicate in GL", "value": 180}, {"label": "Check Number Mismatch", "value": 1600}, {"label": "Reference Number Mismatch", "value": 450}, {"label": "Date Variance", "value": 3200}, {"label": "Timing Difference", "value": 4800}, {"label": "Weak Description Match", "value": 812.4}, {"label": "Ambiguous Match Requiring Review", "value": 85}, {"label": "Reversal / Void Pair", "value": 1000}, {"label": "Stale Outstanding Check", "value": 150}, {"label": "Description/Merchant Variance", "value": 245}, {"label": "Interest Income", "value": 12.5}, {"label": "Outstanding Check", "value": 273.5}, {"label": "Deposit in Transit", "value": 250}], "title": "Dollar Exposure by Exception Category"}, {"id": "outstandingCheckAging", "data": [{"label": "0-5 days", "value": 0}, {"label": "6-30 days", "value": 1}, {"label": "31-44 days", "value": 0}, {"label": "45+ days", "value": 1}], "title": "Outstanding Check Aging"}]', '2026-09-04 12:27:08.203274+00', '2026-09-04 12:27:08.203274+00', 'bfe98882-971e-45dc-a2a8-7bef972d1182', :'seed_org_id') ON CONFLICT DO NOTHING;


