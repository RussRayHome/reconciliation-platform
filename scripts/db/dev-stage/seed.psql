INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('e0efe214-02d7-4fc0-b484-32bd2fa58cc3', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'c2bd8892-fc92-4c39-bc26-b02a11e12f69', 'MissingFromGL', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 31, '2025-11-15', -100.00, 'Transaction appears in bank activity but no corresponding GL entry was identified within the permitted date and amount tolerance.', '{"reason": "No GL-side transaction remained after exact, review, and variance matching rules were applied.", "ruleId": "missing-from-gl", "evidence": ["Transaction stayed unmatched after cross-source candidate selection."], "ruleName": "Missing from GL"}', '[]', '{"Check whether the bank transaction was recorded to the correct GL account and period.","Create or correct the GL entry if source support confirms the bank activity is valid."}', NULL, NULL, NULL, '{EXPENSE,OPERATING,UNMATCHED}', '{c2bd8892-fc92-4c39-bc26-b02a11e12f69}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('8de93155-d4fd-4731-b6fc-54d5c3e2daba', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'd7357d63-4ac0-4241-a652-5fadf9b83e7b', 'AmountMismatch', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 2, '2025-03-04', -500.00, 'Likely matched transaction found in both sources; however, recorded amounts differ and require review of original source documentation.', '{"reason": "Dates and narrative context indicate likely related transactions. Recorded amounts differ by more than the configured tolerance of 0.01.", "ruleId": "possible-amount-mismatch", "evidence": ["Dates and narrative context indicate likely related transactions.", "Recorded amounts differ by more than the configured tolerance of 0.01."], "ruleName": "Possible Amount Mismatch", "counterpart": {"amount": -520, "source": "gl", "lineNumber": 2, "transactionId": "31a210e4-ada2-4d50-9a67-17c1b961c4e7", "transactionDate": "2025-03-04", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -520, "source": "gl", "lineNumber": 2, "transactionId": "31a210e4-ada2-4d50-9a67-17c1b961c4e7", "transactionDate": "2025-03-04", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Compare source documents and settlement detail to determine which amount is authoritative.","Post an adjusting entry or correct the recorded amount after support is confirmed."}', '31a210e4-ada2-4d50-9a67-17c1b961c4e7', NULL, 'AmountMismatch', '{993,ALPHA,INV,VENDOR,WIRE}', '{d7357d63-4ac0-4241-a652-5fadf9b83e7b,31a210e4-ada2-4d50-9a67-17c1b961c4e7}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('6bb42148-4a08-4e3b-bcc0-d2adcb992c09', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '8640c2d9-4b92-4628-9fdc-3c0d85338e9b', 'LikelyMiscoding', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 8, '2025-03-10', -575.00, 'A same-amount, near-date counterpart exists, but the descriptive or reference context conflicts strongly enough to suggest miscoding rather than a clean match.', '{"reason": "A same-amount, near-date GL transaction exists, but description or reference context conflicts materially.", "ruleId": "likely-miscoding", "evidence": ["Same amount remains unmatched on both sides within the primary date window.", "Date difference is 1 day(s).", "Narrative similarity score is 0.00 and reference similarity score is 0.00.", "The context conflict is strong enough to suggest miscoding rather than a clean missing-item exception."], "ruleName": "Likely Miscoding", "counterpart": {"amount": -575, "source": "gl", "lineNumber": 10, "transactionId": "9e7541dc-ad1e-40ee-a87c-aed18a19b576", "transactionDate": "2025-03-11", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -575, "source": "gl", "lineNumber": 10, "transactionId": "9e7541dc-ad1e-40ee-a87c-aed18a19b576", "transactionDate": "2025-03-11", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Review both source lines to determine whether the transaction was posted to the wrong vendor, customer, or account.","Prepare a reclassification entry if the amount is correct but the accounting context is wrong."}', '9e7541dc-ad1e-40ee-a87c-aed18a19b576', NULL, 'Probable', '{ACME,PAYROLL}', '{8640c2d9-4b92-4628-9fdc-3c0d85338e9b,9e7541dc-ad1e-40ee-a87c-aed18a19b576}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('3ed1c01f-8ac3-4f0e-a598-41b091a0724a', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'd40cb6e2-5e3b-4e41-b0ad-e5c49139b3a2', 'MissingFromGL', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 15, '2025-03-31', -200.00, 'Transaction appears in bank activity but no corresponding GL entry was identified within the permitted date and amount tolerance.', '{"reason": "No GL-side transaction remained after exact, review, and variance matching rules were applied.", "ruleId": "missing-from-gl", "evidence": ["Transaction stayed unmatched after cross-source candidate selection."], "ruleName": "Missing from GL"}', '[]', '{"Check whether the bank transaction was recorded to the correct GL account and period.","Create or correct the GL entry if source support confirms the bank activity is valid."}', NULL, NULL, NULL, '{ACTIVITY,OPERATING}', '{d40cb6e2-5e3b-4e41-b0ad-e5c49139b3a2}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('3fe663db-d0bc-4fcc-9675-37156376d05b', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '6ccd0fb3-e7ff-42ab-97b7-5847b9eb91f1', 'MissingFromGL', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 16, '2025-04-30', -100.00, 'Transaction appears in bank activity but no corresponding GL entry was identified within the permitted date and amount tolerance.', '{"reason": "No GL-side transaction remained after exact, review, and variance matching rules were applied.", "ruleId": "missing-from-gl", "evidence": ["Transaction stayed unmatched after cross-source candidate selection."], "ruleName": "Missing from GL"}', '[]', '{"Check whether the bank transaction was recorded to the correct GL account and period.","Create or correct the GL entry if source support confirms the bank activity is valid."}', NULL, NULL, NULL, '{ACTIVITY,END,MONTH}', '{6ccd0fb3-e7ff-42ab-97b7-5847b9eb91f1}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('d4015c48-2095-4b08-add6-3f33f449d579', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'a413440b-aec6-47c1-a224-553199673d3b', 'VoidedCheckCleared', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 25, '2025-11-12', -657.33, 'A bank check debit has no corresponding GL entry. This may indicate the check was voided in GL but still cleared the bank, or it was issued but never recorded. Either scenario requires immediate review.', '{"reason": "A bank check debit has no corresponding GL entry, suggesting the check was voided or never recorded in GL but cleared the bank.", "ruleId": "voided-check-cleared", "evidence": ["Check number 1042 is present on the bank transaction.", "No matching GL entry was found at any amount or date tolerance.", "Verify whether this check was voided in GL or was never recorded."], "ruleName": "Voided Check Cleared"}', '[]', '{"Verify whether this check number was voided in GL; if so, restore the disbursement entry because the bank honored it.","If the check was never recorded, create the GL expense entry and allocate it to the appropriate account."}', NULL, NULL, 'Unmatched', '{CHECK}', '{a413440b-aec6-47c1-a224-553199673d3b}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('cfd74723-7e90-4336-97a4-c442fb4e499c', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01', 'LikelySplitCombineIssue', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 6, '2025-07-15', -300.00, 'Transaction appears to participate in a one-to-many or many-to-one relationship that the current one-to-one matcher cannot resolve automatically.', '{"reason": "Residual unmatched transactions form a one-to-many or many-to-one relationship that the one-to-one matcher cannot settle cleanly.", "ruleId": "grouped-split-combine-residual", "evidence": ["Residual unmatched transactions form a balanced grouped amount across sources.", "Bank total is -300.00 across 1 line(s); GL total is -300.00 across 2 line(s).", "Maximum cross-source date difference is 1 day(s).", "Observed transaction kinds are bank=withdrawal and gl=withdrawal.", "Narrative similarity score is 0.44 and reference similarity score is 0.00.", "Bank members: BANK line 6 (-300.00).", "GL members: GL line 6 (-120.00), GL line 7 (-180.00)."], "ruleName": "Grouped Split/Combine Residual", "counterpart": {"amount": -120, "source": "gl", "lineNumber": 6, "transactionId": "a8899a07-3b82-48d0-8ecb-0d84411d27e5", "transactionDate": "2025-07-15", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -120, "source": "gl", "lineNumber": 6, "transactionId": "a8899a07-3b82-48d0-8ecb-0d84411d27e5", "transactionDate": "2025-07-15", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, {"amount": -180, "source": "gl", "lineNumber": 7, "transactionId": "8e683e61-2f0b-45bf-8188-3d3c37181f40", "transactionDate": "2025-07-16", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Review nearby transactions for one-to-many or many-to-one combinations that sum to the same net activity.","Document the grouped relationship and retain support until grouped matching logic is implemented."}', 'a8899a07-3b82-48d0-8ecb-0d84411d27e5', NULL, 'Probable', '{BATCH,SETTLEMENT,VENDOR}', '{6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01,a8899a07-3b82-48d0-8ecb-0d84411d27e5,8e683e61-2f0b-45bf-8188-3d3c37181f40}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('a39677e7-cbe4-49be-a1df-fbe02dfebfc3', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '05574aa9-7dc8-4cbb-8e20-6399b72d0e27', 'DepositGroupingIssue', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 7, '2025-08-05', 3200.00, 'Transaction likely belongs to a grouped deposit or batched bank receipt pattern that requires grouped review rather than one-to-one matching.', '{"reason": "Residual unmatched deposits form a grouped receipt pattern rather than independent missing items.", "ruleId": "grouped-deposit-residual", "evidence": ["Residual unmatched transactions form a balanced grouped amount across sources.", "Bank total is 3200.00 across 1 line(s); GL total is 3200.00 across 2 line(s).", "Maximum cross-source date difference is 1 day(s).", "Observed transaction kinds are bank=deposit and gl=deposit.", "Narrative similarity score is 0.22 and reference similarity score is 0.00.", "Bank members: BANK line 7 (3200.00).", "GL members: GL line 9 (1200.00), GL line 8 (2000.00)."], "ruleName": "Grouped Deposit Residual", "counterpart": {"amount": 1200, "source": "gl", "lineNumber": 9, "transactionId": "3b1c9bac-4294-45c9-81c6-3e0235ac8ded", "transactionDate": "2025-08-05", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": 1200, "source": "gl", "lineNumber": 9, "transactionId": "3b1c9bac-4294-45c9-81c6-3e0235ac8ded", "transactionDate": "2025-08-05", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, {"amount": 2000, "source": "gl", "lineNumber": 8, "transactionId": "806c9ac0-4665-4058-ac04-d12adeca8b5e", "transactionDate": "2025-08-04", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Compare the bank deposit to underlying receipts or batch detail to confirm whether multiple book entries roll into one deposit.","Retain the deposit support package and document the grouped components for reviewer sign-off."}', '3b1c9bac-4294-45c9-81c6-3e0235ac8ded', NULL, 'Probable', '{BATCH,DEPOSIT,MERCHANT,SERVICES}', '{05574aa9-7dc8-4cbb-8e20-6399b72d0e27,3b1c9bac-4294-45c9-81c6-3e0235ac8ded,806c9ac0-4665-4058-ac04-d12adeca8b5e}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('fe246c12-0b10-4c89-8c03-48185efbf7de', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '71ad31d1-9a9e-4abf-ba4e-a6c1a76edac9', 'MissingFromGL', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 1, '2025-09-02', -45.00, 'Transaction appears in bank activity but no corresponding GL entry was identified within the permitted date and amount tolerance.', '{"reason": "No GL-side transaction remained after exact, review, and variance matching rules were applied.", "ruleId": "missing-from-gl", "evidence": ["Transaction stayed unmatched after cross-source candidate selection."], "ruleName": "Missing from GL"}', '[]', '{"Check whether the bank transaction was recorded to the correct GL account and period.","Create or correct the GL entry if source support confirms the bank activity is valid."}', NULL, NULL, NULL, '{BANK,FEE,UNBOOKED}', '{71ad31d1-9a9e-4abf-ba4e-a6c1a76edac9}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('495d67f1-b3ed-42be-999e-4db49b856034', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'ab8f83a5-0e8f-4618-b1a0-80940ccbb3eb', 'DuplicateInBank', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 4, '2025-09-05', -210.00, 'Bank entry appears duplicated based on same amount, date proximity, and materially similar description.', '{"reason": "Same-source duplicate detected from amount equality, close dates, and similar description or reference tokens.", "ruleId": "duplicate-detection", "evidence": ["Same amount within the configured tolerance of 0.01.", "Date proximity falls within duplicate detection window.", "Description or reference similarity indicates a duplicate posting."], "ruleName": "Duplicate Detection in Bank"}', '[]', '{"Review bank posting detail to determine whether the item is an actual duplicate or a reversal pattern.","If duplicated, document the bank-side resolution and remove the extra item from reconciliation support."}', NULL, NULL, 'Probable', '{EFT,OMEGA,VENDOR}', '{ab8f83a5-0e8f-4618-b1a0-80940ccbb3eb}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('7f74c5c4-16e2-48d8-a8d6-68c7d1ab30fa', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '8fe29347-7b18-4045-92ca-38a5fa5a5796', 'IntercompanyMismatch', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 35, '2025-09-25', -1000.00, 'Transaction contains intercompany or entity-transfer indicators but has no counterpart in the other source. Confirm whether this belongs to a different entity or account.', '{"reason": "Bank transaction contains intercompany or entity-transfer keywords with no counterpart in GL.", "ruleId": "intercompany-mismatch", "evidence": ["Transaction description contains intercompany or entity-transfer indicators.", "No matching GL entry was found within the configured date and amount tolerance.", "Verify whether this transaction belongs to a different legal entity or GL file."], "ruleName": "Intercompany / Entity Mismatch"}', '[]', '{"Verify whether this transaction belongs to a different legal entity or general ledger file.","If intercompany, record the due-to/due-from entry in both entity files to balance the intercompany accounts."}', NULL, NULL, 'Unmatched', '{ALPHA,DUE,FROM,SUBSIDIARY}', '{8fe29347-7b18-4045-92ca-38a5fa5a5796}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('29735f70-204b-454e-ad87-605571b7b9b5', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'f5e36e17-33b1-4061-b979-3d4f799cf262', 'FeeNettingMatch', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 18, '2025-10-01', 93.17, 'A bank credit matches the net of a GL revenue entry and a fee expense entry, indicating a payment processor or merchant aggregator deducted its fee before remitting. The net amount reconciles correctly; no action is required unless the gross amounts need to be restated.', '{"reason": "A bank credit matches the net of a GL revenue entry minus a fee expense, indicating a fee-netted payout.", "ruleId": "fee-netting-reserved", "evidence": ["Bank credit of 93.17 matches GL revenue 101.80 + fee -8.63 = 93.17.", "Maximum cross-source date difference is 0 day(s).", "Bank: seed-bank-all-exceptions.xlsx:L18; GL revenue: seed-gl-all-exceptions.xlsx:L19; GL fee: seed-gl-all-exceptions.xlsx:L20."], "ruleName": "Fee Netting Candidate", "counterpart": {"amount": 101.8, "source": "gl", "lineNumber": 19, "transactionId": "9860397a-cec0-4ad6-8338-921e84c90c28", "transactionDate": "2025-10-01", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": 101.8, "source": "gl", "lineNumber": 19, "transactionId": "9860397a-cec0-4ad6-8338-921e84c90c28", "transactionDate": "2025-10-01", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, {"amount": -8.63, "source": "gl", "lineNumber": 20, "transactionId": "511fc005-04af-42e7-b54e-85f511843f7b", "transactionDate": "2025-10-01", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Confirm the gross revenue and fee amounts in GL agree with the payment processor remittance detail.","If gross amounts need to be restated, reclassify the fee to a dedicated bank charge account and record the full revenue separately."}', '9860397a-cec0-4ad6-8338-921e84c90c28', NULL, 'Probable', '{NET,PAYOUT,STRIPE}', '{f5e36e17-33b1-4061-b979-3d4f799cf262,9860397a-cec0-4ad6-8338-921e84c90c28,511fc005-04af-42e7-b54e-85f511843f7b}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('f0f6a401-200a-4f0f-9be4-e443d2f13844', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'ea1f27fc-02c4-4972-8dbd-b5a85208148e', 'PartialPaymentMatch', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 19, '2025-10-05', -150.75, 'Multiple bank debits together equal a single GL disbursement, indicating a single invoice was paid in installments or split across separate bank runs. Review to confirm all installments are accounted for and no partial payment remains outstanding.', '{"reason": "Multiple bank debits with similar payee context accumulate to a single GL payable, indicating partial payments.", "ruleId": "partial-payment-reserved", "evidence": ["Bank total of -301.50 across 2 payment(s) matches GL payable of -301.50.", "Average inter-bank payee similarity is 0.86.", "Maximum cross-source date difference is 4 day(s) (window: 90 days).", "Bank members: seed-bank-all-exceptions.xlsx:L19:-150.75; seed-bank-all-exceptions.xlsx:L20:-150.75.", "GL payable: seed-gl-all-exceptions.xlsx:L21:-301.50."], "ruleName": "Partial Payment Candidate", "counterpart": {"amount": -301.5, "source": "gl", "lineNumber": 21, "transactionId": "27f8b3ef-f52a-46db-9a75-24ffb60e2f07", "transactionDate": "2025-10-05", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -301.5, "source": "gl", "lineNumber": 21, "transactionId": "27f8b3ef-f52a-46db-9a75-24ffb60e2f07", "transactionDate": "2025-10-05", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Verify all installment bank debits are recorded in GL and that the total equals the invoice amount.","Confirm no remaining balance is outstanding on the original GL payable."}', '27f8b3ef-f52a-46db-9a75-24ffb60e2f07', NULL, 'Probable', '{1,992,DELTA,INSTALLMENT,INV,PART,VENDOR}', '{ea1f27fc-02c4-4972-8dbd-b5a85208148e,1ff8d0f6-fa3d-43eb-80bf-f6cb1d7a8a6b,27f8b3ef-f52a-46db-9a75-24ffb60e2f07}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('e069b014-571f-4bd1-bc16-6326de651be2', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'ea1f27fc-02c4-4972-8dbd-b5a85208148e', 'PartialPaymentMatch', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 20, '2025-10-09', -150.75, 'Multiple bank debits together equal a single GL disbursement, indicating a single invoice was paid in installments or split across separate bank runs. Review to confirm all installments are accounted for and no partial payment remains outstanding.', '{"reason": "Multiple bank debits with similar payee context accumulate to a single GL payable, indicating partial payments.", "ruleId": "partial-payment-reserved", "evidence": ["Bank total of -301.50 across 2 payment(s) matches GL payable of -301.50.", "Average inter-bank payee similarity is 0.86.", "Maximum cross-source date difference is 4 day(s) (window: 90 days).", "Bank members: seed-bank-all-exceptions.xlsx:L19:-150.75; seed-bank-all-exceptions.xlsx:L20:-150.75.", "GL payable: seed-gl-all-exceptions.xlsx:L21:-301.50."], "ruleName": "Partial Payment Candidate", "counterpart": {"amount": -301.5, "source": "gl", "lineNumber": 21, "transactionId": "27f8b3ef-f52a-46db-9a75-24ffb60e2f07", "transactionDate": "2025-10-05", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -301.5, "source": "gl", "lineNumber": 21, "transactionId": "27f8b3ef-f52a-46db-9a75-24ffb60e2f07", "transactionDate": "2025-10-05", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Verify all installment bank debits are recorded in GL and that the total equals the invoice amount.","Confirm no remaining balance is outstanding on the original GL payable."}', '27f8b3ef-f52a-46db-9a75-24ffb60e2f07', NULL, 'Probable', '{2,992,DELTA,INSTALLMENT,INV,PART,VENDOR}', '{ea1f27fc-02c4-4972-8dbd-b5a85208148e,1ff8d0f6-fa3d-43eb-80bf-f6cb1d7a8a6b,27f8b3ef-f52a-46db-9a75-24ffb60e2f07}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('2785ed88-3ba6-4726-adfd-2c08d7b2ea14', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'f842187e-a75d-4b53-a1fd-591d89bd6f15', 'ACHReturn', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 29, '2025-10-10', -300.00, 'An ACH debit was returned by the bank (NSF or other return code). The original GL expense remains unreverted and requires a correcting entry.', '{"reason": "An ACH debit was returned by the bank. The bank debit and return credit net to zero.", "ruleId": "ach-return", "evidence": ["Bank debit of -300.00 and bank credit of 300.00 net to zero.", "Date difference is 1 day(s).", "At least one transaction contains ACH return keywords (RETURN, RTN, NSF, R01, R09)."], "ruleName": "ACH Return / NSF", "counterpart": {"amount": 300, "source": "bank", "lineNumber": 30, "transactionId": "ca6b777f-f1cd-4580-b9a5-b072e3917f3b", "transactionDate": "2025-10-11", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, "counterparts": [{"amount": 300, "source": "bank", "lineNumber": 30, "transactionId": "ca6b777f-f1cd-4580-b9a5-b072e3917f3b", "transactionDate": "2025-10-11", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]}', '[]', '{"Verify the ACH return reason code and determine whether to re-submit or write off the expense.","Post a reversal entry in GL to offset the original expense and update cash records."}', 'ca6b777f-f1cd-4580-b9a5-b072e3917f3b', NULL, 'Probable', '{DEBIT,GAMMA,VENDOR}', '{f842187e-a75d-4b53-a1fd-591d89bd6f15,ca6b777f-f1cd-4580-b9a5-b072e3917f3b}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('a1a5cf10-d209-48b3-8653-028fa66997f9', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'f842187e-a75d-4b53-a1fd-591d89bd6f15', 'ACHReturn', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 30, '2025-10-11', 300.00, 'An ACH debit was returned by the bank (NSF or other return code). The original GL expense remains unreverted and requires a correcting entry.', '{"reason": "An ACH return credit offsets a bank debit. The pair nets to zero.", "ruleId": "ach-return", "evidence": ["Bank debit of -300.00 and bank credit of 300.00 net to zero.", "Date difference is 1 day(s).", "At least one transaction contains ACH return keywords (RETURN, RTN, NSF, R01, R09)."], "ruleName": "ACH Return / NSF", "counterpart": {"amount": -300, "source": "bank", "lineNumber": 29, "transactionId": "f842187e-a75d-4b53-a1fd-591d89bd6f15", "transactionDate": "2025-10-10", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, "counterparts": [{"amount": -300, "source": "bank", "lineNumber": 29, "transactionId": "f842187e-a75d-4b53-a1fd-591d89bd6f15", "transactionDate": "2025-10-10", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]}', '[]', '{"Verify the ACH return reason code and determine whether to re-submit or write off the expense.","Post a reversal entry in GL to offset the original expense and update cash records."}', 'f842187e-a75d-4b53-a1fd-591d89bd6f15', NULL, 'Probable', '{GAMMA,NSF,RETURN,VENDOR}', '{f842187e-a75d-4b53-a1fd-591d89bd6f15,ca6b777f-f1cd-4580-b9a5-b072e3917f3b}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('28987da2-a9f8-46d8-a77c-cce0df17c5bc', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '32e8253a-e964-4569-93f3-3f08cb28354f', 'MissingFromGL', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 17, '2025-11-15', -350.00, 'Transaction appears in bank activity but no corresponding GL entry was identified within the permitted date and amount tolerance.', '{"reason": "No GL-side transaction remained after exact, review, and variance matching rules were applied.", "ruleId": "missing-from-gl", "evidence": ["Transaction stayed unmatched after cross-source candidate selection."], "ruleName": "Missing from GL"}', '[]', '{"Check whether the bank transaction was recorded to the correct GL account and period.","Create or correct the GL entry if source support confirms the bank activity is valid."}', NULL, NULL, NULL, '{END,MONTH,OPERATING}', '{32e8253a-e964-4569-93f3-3f08cb28354f}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('66b298d5-2b1d-47b7-84b7-34b14b3b7f58', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '0537dd32-ad91-4d9e-a80b-d52abad39758', 'BankServiceChargeAmortization', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 22, '2025-10-15', -121.00, 'A bank service charge is split across multiple GL fee expense lines, indicating the charge was amortized or allocated across account categories. Confirm the GL allocation totals match the bank charge and that all categories are correct.', '{"reason": "A bank service charge debit matches the aggregate of multiple GL fee expense entries, indicating an amortized or split posting across account categories.", "ruleId": "bank-service-charge-reserved", "evidence": ["Bank service charge of -121.00 matches GL total of -121.00 across 2 expense line(s).", "All GL entries fall within 5 day(s) of the bank charge date.", "Service charge signal detected in bank description: \"MONTHLY SERVICE FEE ACCOUNT MAINTENANCE\"", "Bank: seed-bank-all-exceptions.xlsx:L22; GL lines: L24:-61.00, L25:-60.00."], "ruleName": "Bank Service Charge Candidate", "counterpart": {"amount": -61, "source": "gl", "lineNumber": 24, "transactionId": "9ed02308-644d-4d4c-b4c8-131388847ce6", "transactionDate": "2025-10-15", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -61, "source": "gl", "lineNumber": 24, "transactionId": "9ed02308-644d-4d4c-b4c8-131388847ce6", "transactionDate": "2025-10-15", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, {"amount": -60, "source": "gl", "lineNumber": 25, "transactionId": "26e303eb-2e4c-4cbd-ac49-4955129eb71d", "transactionDate": "2025-10-15", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Verify the sum of all GL fee expense lines equals the bank service charge amount.","Confirm each GL line is allocated to the correct account or cost center."}', '9ed02308-644d-4d4c-b4c8-131388847ce6', NULL, 'Probable', '{ACCOUNT,FEE,MAINTENANCE,MONTHLY,SERVICE}', '{0537dd32-ad91-4d9e-a80b-d52abad39758,9ed02308-644d-4d4c-b4c8-131388847ce6,26e303eb-2e4c-4cbd-ac49-4955129eb71d}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('954e947e-fee3-489d-9485-d9d8ffc2fa82', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'f1bd99f4-4001-4390-abcb-009f7de0bfa1', 'ChargebackReturn', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 33, '2025-10-25', -750.00, 'A bank debit with chargeback or return keywords offsets a previously reconciled bank credit of the same amount. A corresponding GL reversal entry is likely missing.', '{"reason": "A bank debit with chargeback keywords offsets a previously reconciled bank credit of the same amount.", "ruleId": "chargeback-return", "evidence": ["Bank debit of -750.00 contains chargeback keywords.", "A matched bank credit of 750.00 exists 35 day(s) prior (within the 120-day chargeback window).", "A corresponding GL reversal entry is likely missing."], "ruleName": "Chargeback / Returned Item", "counterpart": {"amount": 750, "source": "bank", "lineNumber": 32, "transactionId": "e6934398-92eb-4561-8659-932a82edfd66", "transactionDate": "2025-09-20", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, "counterparts": [{"amount": 750, "source": "bank", "lineNumber": 32, "transactionId": "e6934398-92eb-4561-8659-932a82edfd66", "transactionDate": "2025-09-20", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]}', '[]', '{"Confirm whether a chargeback reversal entry was recorded in GL to offset the original income.","Post a reversing journal entry in GL if the chargeback has not yet been recorded."}', 'e6934398-92eb-4561-8659-932a82edfd66', NULL, 'Probable', '{ALPHA,CHARGEBACK,CLIENT,DISPUTED}', '{f1bd99f4-4001-4390-abcb-009f7de0bfa1,e6934398-92eb-4561-8659-932a82edfd66}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('eca6d3e1-6d41-45db-9b8f-1add07089c78', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'c015ddfe-db71-4091-81c1-6006c2f2e8aa', 'PayrollBatchMatch', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 21, '2025-11-01', -5001.00, 'A single bank payroll ACH debit matches the aggregate of multiple GL individual payroll expense entries. This is expected behavior for batch payroll processing; confirm the GL entries cover all employees in the pay run.', '{"reason": "A bank payroll ACH debit matches the aggregate of multiple GL payroll expense entries posted on the same payroll date.", "ruleId": "payroll-batch-reserved", "evidence": ["Bank payroll debit of -5001.00 matches GL total of -5001.00 across 2 expense line(s).", "All GL entries fall within 5 day(s) of the bank payroll date.", "Payroll processor signal detected in bank description: \"PAYROLL DIRECT DEPOSIT BATCH\"", "Bank: seed-bank-all-exceptions.xlsx:L21; GL lines: L22:-3001.00, L23:-2000.00."], "ruleName": "Payroll Batch Candidate", "counterpart": {"amount": -3001, "source": "gl", "lineNumber": 22, "transactionId": "034d5db1-dc53-4b81-9d4d-3b76f420f9b8", "transactionDate": "2025-11-01", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -3001, "source": "gl", "lineNumber": 22, "transactionId": "034d5db1-dc53-4b81-9d4d-3b76f420f9b8", "transactionDate": "2025-11-01", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, {"amount": -2000, "source": "gl", "lineNumber": 23, "transactionId": "2fc8b5aa-0981-493b-a07b-93649aa1397c", "transactionDate": "2025-11-01", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Cross-reference the GL payroll line items against the payroll processor run report to confirm every employee is included.","If any employees are missing from GL, post the correcting entries and rerun the payroll reconciliation."}', '034d5db1-dc53-4b81-9d4d-3b76f420f9b8', NULL, 'Probable', '{BATCH,DEPOSIT,DIRECT,PAYROLL}', '{c015ddfe-db71-4091-81c1-6006c2f2e8aa,034d5db1-dc53-4b81-9d4d-3b76f420f9b8,2fc8b5aa-0981-493b-a07b-93649aa1397c}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('53ed7e51-c52f-4d66-9919-628ddb7785c4', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'c9a29029-e4a6-4e75-9657-83c4aa66c00d', 'NSFReturnedDeposit', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 24, '2025-11-08', -317.89, 'A bank debit contains indicators of a non-sufficient-funds (NSF) return or returned deposited check. The corresponding customer payment recorded in GL may need to be reversed.', '{"reason": "A bank debit contains NSF or returned-check indicators, suggesting a previously deposited check was returned.", "ruleId": "nsf-returned-deposit", "evidence": ["Bank debit of -317.89 contains NSF or returned-deposit keywords.", "No corresponding bank credit/debit pair was found by the ACH return detector.", "The original customer payment in GL may require reversal."], "ruleName": "NSF / Returned Deposit"}', '[]', '{"Void or reverse the original customer payment in GL to remove the credit from accounts receivable.","Contact the customer to arrange re-payment or reissuance of the returned check."}', NULL, NULL, 'Unmatched', '{ALPHA,CHECK,CUSTOMER,NSF,RETURNED}', '{c9a29029-e4a6-4e75-9657-83c4aa66c00d}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('1f279fe8-93a6-4eb5-a426-bfe4dd42dc6c', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'c842bd52-8171-433c-afa8-67f0bb404fba', 'LoanPaymentSplit', 'High', 'bank', 'seed-bank-all-exceptions.xlsx', 23, '2025-11-10', -1250.00, 'A single bank loan payment debit corresponds to multiple GL entries recording principal reduction and interest expense for the same obligation. This is expected for amortizing loans but requires confirmation that the allocations are correct.', '{"reason": "A bank loan payment debit matches the aggregate of GL principal and interest expense entries for the same obligation.", "ruleId": "loan-payment-split-reserved", "evidence": ["Bank loan payment of -1250.00 matches GL total of -1250.00 across 2 entry(ies).", "All GL entries fall within 5 day(s) of the bank payment date.", "Loan payment signal detected in bank description: \"MORTGAGE PAYMENT WELLS FARGO\"", "Bank: seed-bank-all-exceptions.xlsx:L23; GL lines: L26:-1000.00, L27:-250.00."], "ruleName": "Loan Payment Split Candidate", "counterpart": {"amount": -1000, "source": "gl", "lineNumber": 26, "transactionId": "937c03b3-fffb-4a37-b900-12e577372ec2", "transactionDate": "2025-11-10", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, "counterparts": [{"amount": -1000, "source": "gl", "lineNumber": 26, "transactionId": "937c03b3-fffb-4a37-b900-12e577372ec2", "transactionDate": "2025-11-10", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, {"amount": -250, "source": "gl", "lineNumber": 27, "transactionId": "9779e93d-e683-445e-a360-8eb6ecb9bfcb", "transactionDate": "2025-11-10", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]}', '[]', '{"Confirm that the GL principal and interest allocation matches the lender''s amortization schedule for the period.","Verify the outstanding loan balance on the balance sheet reflects the correct principal reduction."}', '937c03b3-fffb-4a37-b900-12e577372ec2', NULL, 'Probable', '{FARGO,MORTGAGE,WELLS}', '{c842bd52-8171-433c-afa8-67f0bb404fba,937c03b3-fffb-4a37-b900-12e577372ec2,9779e93d-e683-445e-a360-8eb6ecb9bfcb}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('187f1a32-1a2b-4ef6-831a-02720b61a972', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '8640c2d9-4b92-4628-9fdc-3c0d85338e9b', 'LikelyMiscoding', 'High', 'gl', 'seed-gl-all-exceptions.xlsx', 10, '2025-03-11', -575.00, 'A same-amount, near-date counterpart exists, but the descriptive or reference context conflicts strongly enough to suggest miscoding rather than a clean match.', '{"reason": "A same-amount, near-date bank transaction exists, but description or reference context conflicts materially.", "ruleId": "likely-miscoding", "evidence": ["Same amount remains unmatched on both sides within the primary date window.", "Date difference is 1 day(s).", "Narrative similarity score is 0.00 and reference similarity score is 0.00.", "The context conflict is strong enough to suggest miscoding rather than a clean missing-item exception."], "ruleName": "Likely Miscoding", "counterpart": {"amount": -575, "source": "bank", "lineNumber": 8, "transactionId": "8640c2d9-4b92-4628-9fdc-3c0d85338e9b", "transactionDate": "2025-03-10", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, "counterparts": [{"amount": -575, "source": "bank", "lineNumber": 8, "transactionId": "8640c2d9-4b92-4628-9fdc-3c0d85338e9b", "transactionDate": "2025-03-10", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]}', '[]', '{"Review both source lines to determine whether the transaction was posted to the wrong vendor, customer, or account.","Prepare a reclassification entry if the amount is correct but the accounting context is wrong."}', '8640c2d9-4b92-4628-9fdc-3c0d85338e9b', NULL, 'Probable', '{DEPOT,OFFICE,SUPPLIES}', '{8640c2d9-4b92-4628-9fdc-3c0d85338e9b,9e7541dc-ad1e-40ee-a87c-aed18a19b576}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('9909d965-0326-49df-ba40-ca1b0e83a4bf', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'bede6d49-42a6-478c-8e61-e7279ced3398', 'MissingFromBank', 'High', 'gl', 'seed-gl-all-exceptions.xlsx', 11, '2025-04-15', 3200.00, 'Transaction appears in GL activity but no corresponding bank entry was identified within the permitted date and amount tolerance.', '{"reason": "No bank-side transaction remained after exact, review, and variance matching rules were applied.", "ruleId": "missing-from-bank", "evidence": ["Transaction stayed unmatched after cross-source candidate selection."], "ruleName": "Missing from Bank"}', '[]', '{"Inspect the bank statement around the transaction date for an omitted, reversed, or delayed posting.","Confirm whether the GL transaction should be voided, reclassified, or carried as an outstanding item."}', NULL, NULL, NULL, '{BATCH,CLEARING,CLIENT,DEPOSIT}', '{bede6d49-42a6-478c-8e61-e7279ced3398}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('9ebdb81c-806f-4e62-a321-6403129bd477', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'e83e7f5e-6617-4c45-a3bb-de7d7f8a7f68', 'MissingFromBank', 'High', 'gl', 'seed-gl-all-exceptions.xlsx', 29, '2025-06-15', -85.00, 'Transaction appears in GL activity but no corresponding bank entry was identified within the permitted date and amount tolerance.', '{"reason": "No bank-side transaction remained after exact, review, and variance matching rules were applied.", "ruleId": "missing-from-bank", "evidence": ["Transaction stayed unmatched after cross-source candidate selection."], "ruleName": "Missing from Bank"}', '[]', '{"Inspect the bank statement around the transaction date for an omitted, reversed, or delayed posting.","Confirm whether the GL transaction should be voided, reclassified, or carried as an outstanding item."}', NULL, NULL, NULL, '{B,CARD,FUEL,SHELL,TAG,VENDOR}', '{e83e7f5e-6617-4c45-a3bb-de7d7f8a7f68}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('4a0ac83f-8b4f-4eb8-a58b-35e1a882815e', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01', 'LikelySplitCombineIssue', 'High', 'gl', 'seed-gl-all-exceptions.xlsx', 6, '2025-07-15', -120.00, 'Transaction appears to participate in a one-to-many or many-to-one relationship that the current one-to-one matcher cannot resolve automatically.', '{"reason": "Residual unmatched transactions form a one-to-many or many-to-one relationship that the one-to-one matcher cannot settle cleanly.", "ruleId": "grouped-split-combine-residual", "evidence": ["Residual unmatched transactions form a balanced grouped amount across sources.", "Bank total is -300.00 across 1 line(s); GL total is -300.00 across 2 line(s).", "Maximum cross-source date difference is 1 day(s).", "Observed transaction kinds are bank=withdrawal and gl=withdrawal.", "Narrative similarity score is 0.44 and reference similarity score is 0.00.", "Bank members: BANK line 6 (-300.00).", "GL members: GL line 6 (-120.00), GL line 7 (-180.00)."], "ruleName": "Grouped Split/Combine Residual", "counterpart": {"amount": -300, "source": "bank", "lineNumber": 6, "transactionId": "6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01", "transactionDate": "2025-07-15", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, "counterparts": [{"amount": -300, "source": "bank", "lineNumber": 6, "transactionId": "6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01", "transactionDate": "2025-07-15", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]}', '[]', '{"Review nearby transactions for one-to-many or many-to-one combinations that sum to the same net activity.","Document the grouped relationship and retain support until grouped matching logic is implemented."}', '6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01', NULL, 'Probable', '{1,ALPHA,PART,SETTLEMENT,VENDOR}', '{6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01,a8899a07-3b82-48d0-8ecb-0d84411d27e5,8e683e61-2f0b-45bf-8188-3d3c37181f40}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('7590e018-2516-4553-818f-901b54d215e1', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01', 'LikelySplitCombineIssue', 'High', 'gl', 'seed-gl-all-exceptions.xlsx', 7, '2025-07-16', -180.00, 'Transaction appears to participate in a one-to-many or many-to-one relationship that the current one-to-one matcher cannot resolve automatically.', '{"reason": "Residual unmatched transactions form a one-to-many or many-to-one relationship that the one-to-one matcher cannot settle cleanly.", "ruleId": "grouped-split-combine-residual", "evidence": ["Residual unmatched transactions form a balanced grouped amount across sources.", "Bank total is -300.00 across 1 line(s); GL total is -300.00 across 2 line(s).", "Maximum cross-source date difference is 1 day(s).", "Observed transaction kinds are bank=withdrawal and gl=withdrawal.", "Narrative similarity score is 0.44 and reference similarity score is 0.00.", "Bank members: BANK line 6 (-300.00).", "GL members: GL line 6 (-120.00), GL line 7 (-180.00)."], "ruleName": "Grouped Split/Combine Residual", "counterpart": {"amount": -300, "source": "bank", "lineNumber": 6, "transactionId": "6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01", "transactionDate": "2025-07-15", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, "counterparts": [{"amount": -300, "source": "bank", "lineNumber": 6, "transactionId": "6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01", "transactionDate": "2025-07-15", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]}', '[]', '{"Review nearby transactions for one-to-many or many-to-one combinations that sum to the same net activity.","Document the grouped relationship and retain support until grouped matching logic is implemented."}', '6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01', NULL, 'Probable', '{2,ALPHA,PART,SETTLEMENT,VENDOR}', '{6ef93d36-2e4f-4d4c-a8e9-a8c8663b1d01,a8899a07-3b82-48d0-8ecb-0d84411d27e5,8e683e61-2f0b-45bf-8188-3d3c37181f40}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_exception (id, job_id, canonical_row_id, category, severity, source_system, spreadsheet_file_name, line_number, transaction_date, amount, error_message, rule_trace_json, prior_rule_traces_json, recommended_next_actions, likely_matching_reference, reviewer_notes, match_confidence, normalized_comparison_tokens, related_transaction_ids, created_at, organization_id, age_in_days) VALUES ('fc25632e-88e0-476b-9af7-9d844130ba75', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', '05574aa9-7dc8-4cbb-8e20-6399b72d0e27', 'DepositGroupingIssue', 'High', 'gl', 'seed-gl-all-exceptions.xlsx', 8, '2025-08-04', 2000.00, 'Transaction likely belongs to a grouped deposit or batched bank receipt pattern that requires grouped review rather than one-to-one matching.', '{"reason": "Residual unmatched deposits form a grouped receipt pattern rather than independent missing items.", "ruleId": "grouped-deposit-residual", "evidence": ["Residual unmatched transactions form a balanced grouped amount across sources.", "Bank total is 3200.00 across 1 line(s); GL total is 3200.00 across 2 line(s).", "Maximum cross-source date difference is 1 day(s).", "Observed transaction kinds are bank=deposit and gl=deposit.", "Narrative similarity score is 0.22 and reference similarity score is 0.00.", "Bank members: BANK line 7 (3200.00).", "GL members: GL line 9 (1200.00), GL line 8 (2000.00)."], "ruleName": "Grouped Deposit Residual", "counterpart": {"amount": 3200, "source": "bank", "lineNumber": 7, "transactionId": "05574aa9-7dc8-4cbb-8e20-6399b72d0e27", "transactionDate": "2025-08-05", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, "counterparts": [{"amount": 3200, "source": "bank", "lineNumber": 7, "transactionId": "05574aa9-7dc8-4cbb-8e20-6399b72d0e27", "transactionDate": "2025-08-05", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]}', '[]', '{"Compare the bank deposit to underlying receipts or batch detail to confirm whether multiple book entries roll into one deposit.","Retain the deposit support package and document the grouped components for reviewer sign-off."}', '05574aa9-7dc8-4cbb-8e20-6399b72d0e27', NULL, 'Probable', '{A,BATCH,CUSTOMER,RECEIPT}', '{05574aa9-7dc8-4cbb-8e20-6399b72d0e27,3b1c9bac-4294-45c9-81c6-3e0235ac8ded,806c9ac0-4665-4058-ac04-d12adeca8b5e}', '2026-09-04 12:27:08.203274+00', :'seed_org_id', NULL) ON CONFLICT DO NOTHING;
