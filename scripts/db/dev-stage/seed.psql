INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('441fe64f-143c-4739-b227-d6ee768c4af5', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', '78dd6083-76a8-4c61-bb0e-bed7d91950d9', 'amount-+-extended-date-window-match', 'Amount + Extended Date Window Match', true, 1, 'Amounts agree within the configured tolerance of 0.01. Date variance remains outside the primary tolerance but inside the extended review window.', '["Amounts agree within the configured tolerance of 0.01.", "Date variance remains outside the primary tolerance but inside the extended review window."]', 'bede6d49-42a6-478c-8e61-e7279ced3398', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('59f18483-0ce9-4c34-90c3-619835e2699c', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', 'cefd17ce-5447-49f8-9f8c-6ef2383a93c9', 'residual-timing-difference', 'Residual Timing Difference', true, 1, 'A same-amount, timing-compatible GL transaction remains unmatched within the extended timing window.', '["Same-amount residual transactions remained unmatched after exact and review matching.", "Date difference is 19 day(s), which is outside the primary tolerance and within the timing-difference window.", "Narrative similarity score is 1.00 and reference similarity score is 0.00.", "Transaction kinds remain timing-compatible: bank=withdrawal, gl=withdrawal."]', 'a9446e12-21ec-4742-aa83-e5074c18ca94', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('4f8b0f88-488a-4ee9-afa3-7bfd6ed9be0c', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', 'cefd17ce-5447-49f8-9f8c-6ef2383a93c9', 'amount-+-extended-date-window-match', 'Amount + Extended Date Window Match', false, 0.5, 'Amounts agree within the configured tolerance of 0.01. Date variance remains outside the primary tolerance but inside the extended review window.', '["Amounts agree within the configured tolerance of 0.01.", "Date variance remains outside the primary tolerance but inside the extended review window."]', 'a9446e12-21ec-4742-aa83-e5074c18ca94', 1, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('27216a85-14f5-4a2d-b2c4-2c121f42f8ee', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', '38801740-9972-4c63-b5b9-8ae76e87098f', 'amount-+-date-match,-weak-description', 'Amount + Date Match, Weak Description', true, 1, 'Amounts agree within the configured tolerance of 0.01 and dates fall within the primary tolerance window. Description or payee text shares little vocabulary between sources (best similarity 38%), but this amount occurs at most 1 time(s) on each side, making amount and date alone a trustworthy signal. Reviewer confirmation is required before treating this as a confirmed match.', '["Amounts agree within the configured tolerance of 0.01 and dates fall within the primary tolerance window.", "Description or payee text shares little vocabulary between sources (best similarity 38%), but this amount occurs at most 1 time(s) on each side, making amount and date alone a trustworthy signal.", "Reviewer confirmation is required before treating this as a confirmed match."]', '476b4736-e53a-4427-aaef-480bd38936d2', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('646a81e9-478b-4afc-bdac-ddd3a77a2a0c', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', 'cc41ffb3-b2db-4486-8d31-446125308d0d', 'amount-+-date-with-description-variance', 'Amount + Date with Description Variance', true, 1, 'Amounts align and dates are close, but description or merchant context still needs review. Reviewer confirmation is required before the match can be treated as exact.', '["Amounts align and dates are close, but description or merchant context still needs review.", "Reviewer confirmation is required before the match can be treated as exact."]', 'ff2bc2ac-887a-41fb-873c-79fff9f87f94', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('bb05eb27-30ae-4c33-b0c2-bdf0d7960901', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', '595edec7-bfec-45a5-94fd-6cebf3de63fe', 'reversal-void', 'Reversal / Void Pair', true, 1, 'A bank debit and credit of the same amount within the reversal window indicate a reversal or void.', '["Bank debit and credit of 500.00 net to zero, indicating a reversal or void.", "Date difference is 1 day(s).", "Narrative similarity score is 0.75."]', 'b169563b-7cf7-48f0-85d7-2215b0388d24', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
