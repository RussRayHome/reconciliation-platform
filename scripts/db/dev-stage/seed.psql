INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('de01af47-d50a-4d4b-b99d-6ed348f31973', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', 'ea8a3e86-6123-4493-a542-3edbe8b88549', 'stale-outstanding-check', 'Stale Outstanding Check', true, 1, 'GL check-like disbursement remains unmatched in bank activity 278 days after its recorded date.', '["Transaction remains unmatched on the bank side after matching completed.", "Recorded age relative to the latest statement activity is 278 days.", "Transaction type indicates a check-like disbursement."]', NULL, 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
