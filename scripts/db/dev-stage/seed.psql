INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('31b92825-5cf5-4ea1-a103-2aa02d381327', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', '954e947e-fee3-489d-9485-d9d8ffc2fa82', 'chargeback-return', 'Chargeback / Returned Item', true, 1, 'A bank debit with chargeback keywords offsets a previously reconciled bank credit of the same amount.', '["Bank debit of -750.00 contains chargeback keywords.", "A matched bank credit of 750.00 exists 35 day(s) prior (within the 120-day chargeback window).", "A corresponding GL reversal entry is likely missing."]', 'e6934398-92eb-4561-8659-932a82edfd66', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('4a205dd3-77d0-4e9a-bb67-470669ed80f2', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', 'eca6d3e1-6d41-45db-9b8f-1add07089c78', 'payroll-batch-reserved', 'Payroll Batch Candidate', true, 1, 'A bank payroll ACH debit matches the aggregate of multiple GL payroll expense entries posted on the same payroll date.', '["Bank payroll debit of -5001.00 matches GL total of -5001.00 across 2 expense line(s).", "All GL entries fall within 5 day(s) of the bank payroll date.", "Payroll processor signal detected in bank description: \"PAYROLL DIRECT DEPOSIT BATCH\"", "Bank: seed-bank-all-exceptions.xlsx:L21; GL lines: L22:-3001.00, L23:-2000.00."]', '034d5db1-dc53-4b81-9d4d-3b76f420f9b8', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('4e8d860f-0fde-4c7a-a852-4df0ad5a039a', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', '53ed7e51-c52f-4d66-9919-628ddb7785c4', 'nsf-returned-deposit', 'NSF / Returned Deposit', true, 1, 'A bank debit contains NSF or returned-check indicators, suggesting a previously deposited check was returned.', '["Bank debit of -317.89 contains NSF or returned-deposit keywords.", "No corresponding bank credit/debit pair was found by the ACH return detector.", "The original customer payment in GL may require reversal."]', NULL, 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('badcf853-e7c1-4f01-91be-778b83ffdebf', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', '1f279fe8-93a6-4eb5-a426-bfe4dd42dc6c', 'loan-payment-split-reserved', 'Loan Payment Split Candidate', true, 1, 'A bank loan payment debit matches the aggregate of GL principal and interest expense entries for the same obligation.', '["Bank loan payment of -1250.00 matches GL total of -1250.00 across 2 entry(ies).", "All GL entries fall within 5 day(s) of the bank payment date.", "Loan payment signal detected in bank description: \"MORTGAGE PAYMENT WELLS FARGO\"", "Bank: seed-bank-all-exceptions.xlsx:L23; GL lines: L26:-1000.00, L27:-250.00."]', '937c03b3-fffb-4a37-b900-12e577372ec2', 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('def24b47-9fb7-4ce7-9e94-3a0de51dbfc9', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', 'd4015c48-2095-4b08-add6-3f33f449d579', 'voided-check-cleared', 'Voided Check Cleared', true, 1, 'A bank check debit has no corresponding GL entry, suggesting the check was voided or never recorded in GL but cleared the bank.', '["Check number 1042 is present on the bank transaction.", "No matching GL entry was found at any amount or date tolerance.", "Verify whether this check was voided in GL or was never recorded."]', NULL, 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
