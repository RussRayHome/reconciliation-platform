INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('180b04a8-8153-422d-b0db-5b7015bebc25', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'MATCH_GROUP', 'a8684808-47b7-4113-95a3-0f6cbaa9cb19', 'partial-payment-reserved', 'Partial Payment Candidate', true, 102.57142857142857, 'Multiple bank debits with similar payee context accumulate to a single GL payable, indicating partial payments.', '["Bank total of -301.50 across 2 payment(s) matches GL payable of -301.50.", "Average inter-bank payee similarity is 0.86.", "Maximum cross-source date difference is 4 day(s) (window: 90 days).", "Bank members: seed-bank-all-exceptions.xlsx:L19:-150.75; seed-bank-all-exceptions.xlsx:L20:-150.75.", "GL payable: seed-gl-all-exceptions.xlsx:L21:-301.50."]', '27f8b3ef-f52a-46db-9a75-24ffb60e2f07', 0, '2026-09-04 12:27:08.190245+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('f4b88f1b-555a-4329-a206-438f261510bb', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'MATCH_GROUP', 'a8a874bf-16aa-4538-a1c0-cac6d1272de1', 'fee-netting-reserved', 'Fee Netting Candidate', true, 100, 'A bank credit matches the net of a GL revenue entry minus a fee expense, indicating a fee-netted payout.', '["Bank credit of 93.17 matches GL revenue 101.80 + fee -8.63 = 93.17.", "Maximum cross-source date difference is 0 day(s).", "Bank: seed-bank-all-exceptions.xlsx:L18; GL revenue: seed-gl-all-exceptions.xlsx:L19; GL fee: seed-gl-all-exceptions.xlsx:L20."]', '9860397a-cec0-4ad6-8338-921e84c90c28', 1, '2026-09-04 12:27:08.190245+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('a7984225-d7ea-4289-b128-3c407731617c', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'MATCH_GROUP', 'd93e87ed-5b96-419a-95ae-9600131fa848', 'payroll-batch-reserved', 'Payroll Batch Candidate', true, 98, 'A bank payroll ACH debit matches the aggregate of multiple GL payroll expense entries posted on the same payroll date.', '["Bank payroll debit of -5001.00 matches GL total of -5001.00 across 2 expense line(s).", "All GL entries fall within 5 day(s) of the bank payroll date.", "Payroll processor signal detected in bank description: \"PAYROLL DIRECT DEPOSIT BATCH\"", "Bank: seed-bank-all-exceptions.xlsx:L21; GL lines: L22:-3001.00, L23:-2000.00."]', '034d5db1-dc53-4b81-9d4d-3b76f420f9b8', 2, '2026-09-04 12:27:08.190245+00', :'seed_org_id') ON CONFLICT DO NOTHING;
