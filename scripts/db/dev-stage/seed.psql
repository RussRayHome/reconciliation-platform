INSERT INTO public.reconciliation_match_group (id, job_id, disposition, confidence, category, bank_transaction_ids, gl_transaction_ids, bank_members_json, gl_members_json, total_amount, date_difference_days, score, rule_id, rule_name, reason, evidence_json, created_at, organization_id) VALUES ('a8684808-47b7-4113-95a3-0f6cbaa9cb19', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'GroupedReviewMatch', 'Probable', 'PartialPaymentMatch', '{ea1f27fc-02c4-4972-8dbd-b5a85208148e,1ff8d0f6-fa3d-43eb-80bf-f6cb1d7a8a6b}', '{27f8b3ef-f52a-46db-9a75-24ffb60e2f07}', '[{"amount": -150.75, "source": "bank", "lineNumber": 19, "transactionId": "ea1f27fc-02c4-4972-8dbd-b5a85208148e", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}, {"amount": -150.75, "source": "bank", "lineNumber": 20, "transactionId": "1ff8d0f6-fa3d-43eb-80bf-f6cb1d7a8a6b", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]', '[{"amount": -301.5, "source": "gl", "lineNumber": 21, "transactionId": "27f8b3ef-f52a-46db-9a75-24ffb60e2f07", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]', -301.50, 4, 102.57142857142857, 'partial-payment-reserved', 'Partial Payment Candidate', 'Multiple bank debits with similar payee context accumulate to a single GL payable, indicating partial payments.', '["Bank total of -301.50 across 2 payment(s) matches GL payable of -301.50.", "Average inter-bank payee similarity is 0.86.", "Maximum cross-source date difference is 4 day(s) (window: 90 days).", "Bank members: seed-bank-all-exceptions.xlsx:L19:-150.75; seed-bank-all-exceptions.xlsx:L20:-150.75.", "GL payable: seed-gl-all-exceptions.xlsx:L21:-301.50."]', '2026-09-04 12:27:08.190245+00', :'seed_org_id') ON CONFLICT DO NOTHING;
INSERT INTO public.reconciliation_match_group (id, job_id, disposition, confidence, category, bank_transaction_ids, gl_transaction_ids, bank_members_json, gl_members_json, total_amount, date_difference_days, score, rule_id, rule_name, reason, evidence_json, created_at, organization_id) VALUES ('a8a874bf-16aa-4538-a1c0-cac6d1272de1', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'GroupedReviewMatch', 'Probable', 'FeeNettingMatch', '{f5e36e17-33b1-4061-b979-3d4f799cf262}', '{9860397a-cec0-4ad6-8338-921e84c90c28,511fc005-04af-42e7-b54e-85f511843f7b}', '[{"amount": 93.17, "source": "bank", "lineNumber": 18, "transactionId": "f5e36e17-33b1-4061-b979-3d4f799cf262", "spreadsheetFileName": "seed-bank-all-exceptions.xlsx"}]', '[{"amount": 101.8, "source": "gl", "lineNumber": 19, "transactionId": "9860397a-cec0-4ad6-8338-921e84c90c28", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}, {"amount": -8.63, "source": "gl", "lineNumber": 20, "transactionId": "511fc005-04af-42e7-b54e-85f511843f7b", "spreadsheetFileName": "seed-gl-all-exceptions.xlsx"}]', 93.17, 0, 100, 'fee-netting-reserved', 'Fee Netting Candidate', 'A bank credit matches the net of a GL revenue entry minus a fee expense, indicating a fee-netted payout.', '["Bank credit of 93.17 matches GL revenue 101.80 + fee -8.63 = 93.17.", "Maximum cross-source date difference is 0 day(s).", "Bank: seed-bank-all-exceptions.xlsx:L18; GL revenue: seed-gl-all-exceptions.xlsx:L19; GL fee: seed-gl-all-exceptions.xlsx:L20."]', '2026-09-04 12:27:08.190245+00', :'seed_org_id') ON CONFLICT DO NOTHING;
