INSERT INTO public.reconciliation_rule_result (id, job_id, target_kind, target_id, rule_id, rule_name, passed, score, reason, evidence_json, candidate_transaction_id, evaluation_order, created_at, organization_id) VALUES ('1cb59bdb-1121-4d2a-9294-ef42ed6f5256', 'ef87469e-28a3-4e88-9cb8-5cb62cace7d3', 'EXCEPTION_ITEM', 'd340c147-5ef3-49a9-8b4b-adca4033b618', 'outstanding-check', 'Outstanding Check', true, 1, 'GL check-like disbursement has not cleared the bank 8 day(s) after its recorded date, within the normal clearing window.', '["Transaction remains unmatched on the bank side after matching completed.", "Recorded age relative to the latest statement activity is 8 day(s), within the 45-day stale threshold.", "Transaction type indicates a check-like disbursement.", "Carry as an outstanding item and confirm clearance in the next reconciliation cycle."]', NULL, 0, '2026-09-04 12:27:08.203274+00', :'seed_org_id') ON CONFLICT DO NOTHING;
